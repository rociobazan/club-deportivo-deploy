# Copiar a apps/web/.env.local. El .env.local real no se versiona.

# Base de la API de Nest (npm run dev:api). Es la misma en todas las máquinas.
API_URL=http://localhost:3000/api/v1

# Horario de atencion y zona del club, para dibujar la grilla y saber que dia es "hoy".
# Mismos nombres y valores por defecto que en apps/api/.env: si cambian, cambian en los dos.
HORA_APERTURA=08:00
HORA_CIERRE=23:00
ZONA_HORARIA_CLUB=America/Argentina/Cordoba
