# Copiar a apps/api/.env y completar. El .env real no se versiona.

# Contenedor de docker-compose.yml (npm run db:up). Es la misma en todas las máquinas.
DATABASE_URL=postgresql://club:club@localhost:5434/club_reservas

JWT_SECRET=
JWT_EXPIRES_IN=
# Mail. Sin RESEND_API_KEY no se envía nada fuera de producción: el cliente de
# mail es un doble y deja en el log lo que se habría enviado. En producción es
# obligatoria. MAIL_FROM es el remitente del sistema (por defecto
# turnos@clubdeploy.com.ar) y MAIL_CONTACTO la casilla del club que recibe el
# formulario de contacto (por defecto hola@clubdeploy.com.ar).
RESEND_API_KEY=
MAIL_FROM=
MAIL_CONTACTO=
FRONTEND_URL=
HORA_APERTURA=
# Cierre de lunes a viernes (por defecto 23:00) y de los sábados (18:00).
HORA_CIERRE=
HORA_CIERRE_SABADO=
# Días en los que el club no abre, 0 domingo a 6 sábado, separados por coma.
# Por defecto 0. Vacío significa que abre todos los días.
DIAS_CERRADOS=
ZONA_HORARIA_CLUB=

# Reglas de reserva. Las cuatro tienen valor por defecto: sin ellas la API
# arranca igual.
# HORIZONTE_RESERVA_DIAS: hasta cuántos días adelante se puede reservar,
# contando hoy y con el límite inclusivo (30).
# MAX_RESERVAS_ACTIVAS_SOCIO: reservas activas simultáneas de un SOCIO (3). Un
# ADMIN no tiene límite.
# PREFIJO_CODIGO_RESERVA: prefijo del código `<prefijo>-XXXXXX`, de 2 a 5
# letras mayúsculas (RES).
# CANCELACION_MINUTOS_MINIMOS: anticipación mínima para que un SOCIO cancele,
# en minutos (120). Tiene que ser 1 o más: un plazo de 0 dejaría cancelar en el
# segundo en que arranca el turno. Un ADMIN no está sujeto a este límite.
HORIZONTE_RESERVA_DIAS=
MAX_RESERVAS_ACTIVAS_SOCIO=
PREFIJO_CODIGO_RESERVA=
CANCELACION_MINUTOS_MINIMOS=
