# Copiar a apps/api/.env y completar. El .env real no se versiona.

# Contenedor de docker-compose.yml (npm run db:up). Es la misma en todas las máquinas.
DATABASE_URL=postgresql://club:club@localhost:5434/club_reservas

JWT_SECRET=
JWT_EXPIRES_IN=
# Mail. Sin RESEND_API_KEY no se envía nada fuera de producción: el cliente de
# mail es un doble y deja en el log lo que se habría enviado. En producción es
# obligatoria. MAIL_FROM es el remitente del sistema (por defecto
# turnos@clubdeploy.com.ar) y MAIL_CONTACTO la casilla del club que recibe el
# formulario de contacto (por defecto hola@clubdeploy.com.ar).
RESEND_API_KEY=
MAIL_FROM=
MAIL_CONTACTO=
FRONTEND_URL=
CANCELACION_MINUTOS_MINIMOS=
HORIZONTE_RESERVA_DIAS=
MAX_RESERVAS_ACTIVAS_SOCIO=
HORA_APERTURA=
HORA_CIERRE=
PREFIJO_CODIGO_RESERVA=
ZONA_HORARIA_CLUB=
