{
  "name": "club-reservas",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm exec --workspace api -- prisma migrate dev",
    "db:seed": "npm exec --workspace api -- prisma db seed",
    "db:studio": "npm exec --workspace api -- prisma studio",
    "spec:validate": "openspec validate --all --strict",
    "spec:view": "openspec view",
    "contrato:lint": "redocly lint contratos/openapi.yaml",
    "generate:api-types": "openapi-typescript contratos/openapi.yaml -o apps/web/lib/api/schema.d.ts",
    "test:api": "npm run test --workspace api"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.1",
    "@redocly/cli": "^2.53.3",
    "openapi-typescript": "^7.13.0"
  }
}
