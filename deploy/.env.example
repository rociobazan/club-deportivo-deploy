# Copiar a /opt/club/.env en la instancia, completar y dejarlo con chmod 600.
# El .env real no se versiona ni sale de la instancia (ADR 0003).

# Así `docker compose` usa la pila de producción sin pasarle -f cada vez.
COMPOSE_FILE=docker-compose.prod.yml
# La escribe el job `deploy` en cada despliegue: es el SHA del commit publicado.
IMAGE_TAG=

# Dónde se publica el sitio y de dónde salen las imágenes.
DOMINIO=clubdeploy.online
# Usuario u organización de GitHub dueña del repo, en minúsculas.
GHCR_OWNER=rociobazan

# Generarla con: openssl rand -hex 24
# Solo letras y números: va adentro de DATABASE_URL sin codificar.
POSTGRES_PASSWORD=

# Generarlo con: openssl rand -hex 32. Nunca reusar el de otro entorno.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Mail (Resend, con clubdeploy.online verificado).
RESEND_API_KEY=
MAIL_FROM=turnos@clubdeploy.online
# Casilla del equipo que recibe el formulario de contacto.
MAIL_CONTACTO=

# Horario y reglas. Vacías toman el valor por defecto de la API; las de
# horario también las lee el front (docker-compose.prod.yml).
HORA_APERTURA=
HORA_CIERRE=
HORA_CIERRE_SABADO=
DIAS_CERRADOS=0
ZONA_HORARIA_CLUB=
HORIZONTE_RESERVA_DIAS=
MAX_RESERVAS_ACTIVAS_SOCIO=
PREFIJO_CODIGO_RESERVA=
CANCELACION_MINUTOS_MINIMOS=
